# Copy to .env and adjust. Never commit .env (it is git-ignored).
NODE_ENV="production" # development or production

# REQUIRED in production. Generate a long random value, e.g.:  openssl rand -hex 32
HTTP_BEARER_TOKEN=""
HTTP_PORT=3330
HTTP_REQUEST_MAX_JSON_BODY_PAYLOAD_LIMIT="100kb"
HTTP_RATE_LIMIT_WINDOW_MS=60000 # 1 minute
HTTP_RATE_LIMIT_MAX_REQUESTS=10 # requests per window per client

VIDEO_FILE_MAX_UPLOAD_SIZE=524288000 # 500 MB
VIDEOS_DIR="data/videos"
AUDIOS_DIR="data/audios"
JSON_DATA_DIR="data/json"
PROMPTS_DIR="data/prompts"
FILE_RETENTION_DAYS=2

LOG_DIR="data/logs"
LOG_LEVEL="info" # error, warn, info, debug
LOG_FILE_MAX_SIZE="10m"
LOG_RETENTION_DAYS=30

PROCESSING_ONLY="false"
ALLOW_PROCESS_VIDEOS_OUTSIDE_VIDEOS_DIR="false"
ENABLE_PROCESS_LOCK_MECHANISM="true"
PYTHON_BINARY_PATH="python"

PROCESSING_VERBOSE="false"
PROCESSING_LOG_LEVEL="WARNING"
PROCESSING_WHISPER_MODEL="base"
PROCESSING_FPS=1

OLLAMA_AI_API_URL="http://127.0.0.1:11434"
OLLAMA_AI_MODEL="qwen3.5:4b"
OLLAMA_AI_TEMPERATURE=0
OLLAMA_AI_DISABLED="false"
