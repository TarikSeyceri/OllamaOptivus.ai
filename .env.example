# =====================================================================================================
# Ollama Optivus AI - configuration
#
# Create your .env with   ./scripts/init.sh   (Linux/macOS)   or   .\scripts\init.ps1   (Windows):
# it copies this file and fills in random secrets. Never commit .env.
# Docker Compose reads .env; running locally, the API reads it from the working directory.
# The complete reference (every variable, its default and which service uses it): docs/configuration.md
# =====================================================================================================

# --- Secrets (required) --------------------------------------------------------------------------------
# API keys that clients send as "Authorization: Bearer <key>". Use 32+ random characters.
# Several comma-separated keys are accepted at once, so keys can be rotated without downtime.
HTTP_BEARER_TOKEN=
# Shared secret the API uses to call the worker (internal network).
WORKER_TOKEN=

# --- General ---------------------------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# --- HTTP ------------------------------------------------------------------------------------------------
# Where Docker Compose publishes the API. 127.0.0.1 = only this machine (put a TLS reverse proxy in front
# for remote access, see docs/deployment.md). Use 0.0.0.0 to listen on every interface.
OPTIVUS_BIND=127.0.0.1
OPTIVUS_PORT=3330
# Behind a reverse proxy: number of trusted proxy hops (e.g. 1), so rate limits see real client IPs.
HTTP_TRUST_PROXY=false
# Browser origins allowed to call the API, comma-separated (empty = CORS disabled).
HTTP_CORS_ORIGINS=
HTTP_RATE_LIMIT_MAX_REQUESTS=60
HTTP_RATE_LIMIT_HEAVY_MAX_REQUESTS=10
# Swagger UI at /docs and the OpenAPI document at /openapi.json.
API_DOCS_ENABLED=false

# --- Storage ---------------------------------------------------------------------------------------------
VIDEO_FILE_MAX_UPLOAD_SIZE=500mb
# Uploaded videos and everything derived from them are deleted after this many days.
FILE_RETENTION_DAYS=2
STORE_PROMPTS=true
# true = only process videos from storage roots; disables upload, listing and deletion.
PROCESSING_ONLY=false
# Extra read-only video locations, e.g. nas:/mnt/nas,usb:/media/usb. Mount each one into BOTH the api and
# the worker container at the same path (see docs/deployment.md).
PROCESSING_ROOTS=

# --- Language model (Ollama) -----------------------------------------------------------------------------
# Default for one 8 GB GPU. See docs/models.md for 12-16 GB and 24 GB+ recommendations.
OLLAMA_AI_MODEL=qwen3.5:4b
# Extra models clients may request (comma-separated). The default and vision models are always allowed.
OLLAMA_AI_ALLOWED_MODELS=
# Context window. Fixed on purpose: changing it per request makes Ollama reload the model.
OLLAMA_AI_NUM_CTX=16384
OLLAMA_AI_NUM_PREDICT=2048
OLLAMA_AI_TEMPERATURE=0
OLLAMA_AI_KEEP_ALIVE=5m
OLLAMA_AI_THINK=false
OLLAMA_AI_AUTO_PULL=true
# One GPU shared by the worker and Ollama: unload the language model before each video analysis and let
# the worker free its memory afterwards. Set to false when they run on different GPUs.
GPU_SHARED_LOW_VRAM=true
# Scene descriptions: a vision model captions the keyframe of every scene (qwen3.5 models can see images).
OLLAMA_AI_VISION_ENABLED=false
OLLAMA_AI_VISION_MODEL=
OLLAMA_AI_VISION_MAX_FRAMES=30

# --- Video analysis (worker) -----------------------------------------------------------------------------
# Features: objects (YOLO26, AGPL-3.0), ocr (EasyOCR), scenes (scene cuts), faces (facial expressions -
# read the responsible-use note in docs/security.md before enabling it).
PROCESSING_FEATURES=objects,ocr,scenes
# Frames analyzed per second of video (lower = faster; 0.5 is fine for talks and calls).
PROCESSING_FPS=1
PROCESSING_DEVICE=auto
# Whisper model baked into the worker image (rebuild after changing): large-v3-turbo, small, base, ...
PROCESSING_WHISPER_MODEL=large-v3-turbo
# auto = int8_float16 on NVIDIA GPUs, int8 on CPU. float16 is slightly more accurate and needs more VRAM.
PROCESSING_WHISPER_COMPUTE_TYPE=auto
# OCR languages baked into the worker image (rebuild after changing).
PROCESSING_OCR_LANGUAGES=en,tr
PROCESSING_MAX_VIDEO_SECONDS=14400
# Minimum seconds between two keyframes for scene descriptions.
PROCESSING_KEYFRAME_MIN_INTERVAL_SECONDS=10
# Worker image variant: cu126 (NVIDIA driver >= 560), cu129 (RTX 50xx, driver >= 575) or cpu.
TORCH_VARIANT=cu126
