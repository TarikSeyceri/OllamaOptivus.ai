{
  "name": "ollama-optivus.ai",
  "version": "2.0.0",
  "description": "Self-hosted video understanding: speech-to-text, on-screen text, objects and scenes on the GPU, summarized into structured JSON by a local Ollama model.",
  "type": "module",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "author": "Tarik Seyceri",
  "homepage": "https://github.com/TarikSeyceri/OllamaOptivus.ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TarikSeyceri/OllamaOptivus.ai.git"
  },
  "bugs": {
    "url": "https://github.com/TarikSeyceri/OllamaOptivus.ai/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "cross-env NODE_ENV=development AUTH_DISABLED=true node --watch src/main.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "bench:models": "node scripts/bench-models.mjs",
    "openapi": "node scripts/export-openapi.mjs"
  },
  "keywords": [
    "ollama",
    "llm",
    "video-analysis",
    "video-understanding",
    "speech-to-text",
    "whisper",
    "faster-whisper",
    "ocr",
    "easyocr",
    "object-detection",
    "yolo",
    "scene-detection",
    "gpu",
    "cuda",
    "self-hosted",
    "express",
    "fastapi",
    "docker"
  ],
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "ollama": "0.6.4",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-roll": "4.0.0",
    "swagger-ui-express": "5.0.1",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "cross-env": "10.1.0",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10"
  }
}
